# Copy this file to .env.local for local development, and add the same values
# to your host's environment variables (Vercel/Netlify) for the live site.

# Required. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender. Use an address on a domain verified in Resend (resend.com/domains).
# Before the domain is verified, onboarding@resend.dev works, but Resend will only
# deliver to the email address you signed up to Resend with.
CONTACT_FROM="Re-Green & Reclaim Africa <website@regreenreclaimafrica.org>"

# Inbox that receives messages (comma-separate several). Defaults to the email in content/site.ts
CONTACT_TO=info@regreenreclaimafrica.org

# --- Testing with another Resend account (e.g. the developer's) ---
# Use that account's key and a sender on ITS verified domain, and ALWAYS set CONTACT_TO to
# your own inbox, so test messages don't land in the NGO's real inbox:
#   RESEND_API_KEY=re_...developer key...
#   CONTACT_FROM="Re-Green & Reclaim Africa <website@tekhryse.com>"
#   CONTACT_TO=info@tekhryse.com
